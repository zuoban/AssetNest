# AssetNest 环境变量示例（复制为 .env 后按需填写，切勿提交到版本库）

# 配置文件路径（容器内默认为 /config/config.yaml）
ASSETNEST_CONFIG_PATH=/config/config.yaml

# 可选：当在反向代理（HTTPS）后部署时设为 true，使会话 Cookie 附加 Secure 标记
ASSETNEST_COOKIE_SECURE=false

# 可选：S3 兼容对象存储凭证（仅在 config.yaml 中启用 s3 provider 时需要）
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# 可选：WebDAV 存储凭证（仅在 config.yaml 中启用 webdav provider 时需要）
# WEBDAV_URL=https://nas.example.local/remote.php/dav/files/assetnest
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
